rules_version = '2';

// FoodRush — Firestore security rules
// Paste into Firebase console → Firestore Database → Rules → Publish,
// or deploy with the Firebase CLI: firebase deploy --only firestore:rules
//
// Public-ish data (stalls, menus, promos, reviews) is readable by any
// signed-in user. Personal data is not: orders are readable by their
// customer, the stall that received them and admins; user profiles by their
// owner and admins. Every client query filters on the field these rules
// check (customerId / vendorId), which is what lets Firestore allow it.

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in AND not deactivated by an admin. A missing users doc (signup
    // still in progress) counts as active so the create below can succeed.
    function signedIn() {
      return request.auth != null
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
            || get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.get('isActive', true) != false);
    }
    function me() { return request.auth.uid; }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(me())).data.role;
    }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }
    function isCustomer() { return signedIn() && myRole() == 'customer'; }
    function isVendor() { return signedIn() && myRole() == 'vendor'; }
    function ownsStall(vendorId) {
      return isVendor()
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerId == me();
    }

    // Bootstrap: the FIRST account may claim admin. The window closes the
    // moment settings/app_bootstrapped is written (by that same account).
    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/settings/app_bootstrapped);
    }

    // ------------------------------------------------------------ users ----
    match /users/{uid} {
      // Your own profile (even when deactivated, so the app can see the
      // flag) and admins. Names shown elsewhere are denormalized onto
      // orders/reviews, so nobody else needs to read profiles.
      allow read: if (request.auth != null && uid == request.auth.uid) || isAdmin();
      // Roles are set at signup; only the very first account may claim admin
      // (and must immediately write the bootstrap marker to close the window).
      // Customers must use the campus domain.
      allow create: if signedIn() && uid == me()
        && request.resource.data.role in ['customer', 'vendor', 'admin']
        && (request.resource.data.role != 'admin' || bootstrapOpen())
        && (request.resource.data.role != 'customer'
            || request.resource.data.email.matches('.*@lpunetwork\\.edu\\.ph'));
      // Role can never be changed through the client afterwards; admin
      // manages isActive.
      allow update: if (uid == me()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['role', 'isActive']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------- vendors -----
    match /vendors/{vendorId} {
      allow read: if signedIn();
      // Owner creates their own stall doc (during vendor signup), unverified.
      // Admin may also create one for a user they turn into a stall owner.
      allow create: if (isVendor() && request.resource.data.ownerId == me()
                        && request.resource.data.isVerified == false)
                    || isAdmin();
      // Owner edits everything except verification and the rating
      // aggregates; admin may edit anything.
      allow update: if (signedIn() && resource.data.ownerId == me()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['isVerified', 'ownerId', 'ratingSum', 'ratingCount']))
                    || isAdmin();
      // A review (batched with this write) bumps the aggregates: exactly one
      // more review worth 1-5 stars, nothing else touched.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ratingSum', 'ratingCount'])
        && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
        && request.resource.data.ratingSum - resource.data.get('ratingSum', 0) >= 1
        && request.resource.data.ratingSum - resource.data.get('ratingSum', 0) <= 5;
      allow delete: if isAdmin();

      // -------------------------------------------- products / categories --
      match /products/{productId} {
        allow read: if signedIn();
        allow write: if signedIn() && (ownsStall(vendorId) || isAdmin());
        // Checkout takes stock and cancel/reject puts it back, written by the
        // customer: only stockQty may change, and never below zero.
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQty'])
          && request.resource.data.stockQty is int
          && request.resource.data.stockQty >= 0;
      }
      match /categories/{categoryId} {
        allow read: if signedIn();
        allow write: if signedIn() && (ownsStall(vendorId) || isAdmin());
      }
    }

    // ----------------------------------------------------------- orders ----
    match /orders/{orderId} {
      allow read: if signedIn() && (
        resource.data.customerId == me()
        || isAdmin()
        || ownsStall(resource.data.vendorId));

      // Created only through the app's placeOrder transaction. The totals must
      // be internally consistent; whether the line PRICES match the menu
      // can't be checked here (rules can't loop over items), so the stall's
      // order screen re-checks them against its live menu.
      allow create: if isCustomer()
        && request.resource.data.customerId == me()
        && request.resource.data.paymentMethod in ['gcash', 'cash']
        && request.resource.data.status
             == (request.resource.data.paymentMethod == 'cash' ? 'accepted' : 'awaiting_payment')
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && request.resource.data.discount <= request.resource.data.subtotal
        && math.abs(request.resource.data.total
             - (request.resource.data.subtotal - request.resource.data.discount)) < 0.01
        && request.resource.data.receiptUrl == null
        && request.resource.data.get('refundStatus', null) == null
        && get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
             .data.isVerified == true;

      // Customer may cancel an unpaid order, or submit a GCash proof
      // (exactly the four fields submitProof writes, nothing else).
      allow update: if signedIn() && resource.data.customerId == me()
        && (
          (request.resource.data.status == 'cancelled'
            && resource.data.status in ['awaiting_payment', 'proof_submitted']
            // A customer may flag a refund as owed, never as paid out.
            && request.resource.data.get('refundStatus', null) in [null, 'owed'])
          ||
          (request.resource.data.status == 'proof_submitted'
            && resource.data.status == 'awaiting_payment'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['receiptUrl', 'receiptStatus', 'status', 'paymentStatus']))
        );

      // Vendor/admin progress the order through the flow.
      allow update: if isAdmin() || ownsStall(resource.data.vendorId);
    }

    // -------------------------------------------------------- favorites ----
    match /favorites/{favId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.customerId == me();
      allow update, delete: if signedIn() && resource.data.customerId == me();
    }

    // ------------------------------------------------------- promotions ----
    match /promotions/{promoId} {
      allow read: if signedIn();
      // Admins write platform-wide promos; stalls write promos for their own
      // stall (vendorId must point at a stall they own).
      allow create: if isAdmin()
        || (isVendor()
            && request.resource.data.get('vendorId', '') != ''
            && get(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.ownerId == me());
      allow update, delete: if isAdmin()
        || (isVendor() && resource.data.vendorId != null && ownsStall(resource.data.vendorId));
    }

    // --------------------------------------------------------- reviews -----
    // reviews/{orderId}: one per order, by that order's customer, after
    // pickup. Final once written so the stall's aggregates stay correct.
    match /reviews/{reviewId} {
      function reviewedOrder() {
        return get(/databases/$(database)/documents/orders/$(reviewId)).data;
      }
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.customerId == me()
        && request.resource.data.orderId == reviewId
        && reviewedOrder().customerId == me()
        && reviewedOrder().status == 'completed'
        && request.resource.data.vendorId == reviewedOrder().vendorId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      // The stall may add/edit its public reply, nothing else.
      allow update: if ownsStall(resource.data.vendorId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reply', 'repliedAt']);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------- settings -----
    match /settings/{docId} {
      // The bootstrap marker is world-readable (it contains only a timestamp)
      // so the register screen can tell signed-out visitors whether the
      // first-account-admin window is still open.
      allow read: if docId == 'app_bootstrapped' || signedIn();
      // The bootstrap marker is created exactly once and is then immutable —
      // no rule allows its update/delete, so the admin-claim window can never
      // be reopened, even by an admin.
      allow create: if (docId == 'app_bootstrapped' && bootstrapOpen()) || isAdmin();
      allow update, delete: if isAdmin() && docId != 'app_bootstrapped';
    }

    // -------------------------------------------------------- counters -----
    // Queue-number counters are written by the client placeOrder transaction.
    // counters/vendor_{vendorId}: the daily queue number (count/day), bumped
    // by placeOrder, plus `active` (orders the stall is working through),
    // published by the stall's own app for students' wait estimates.
    match /counters/{docId} {
      function ownsCounter() {
        return docId.matches('vendor_.+')
          && ownsStall(docId.split('_')[1]);
      }
      // Queue numbers only ever go up by one, or restart at 1 on a new day.
      function nextQueueNumber() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['count', 'day'])
          && (request.resource.data.count == resource.data.count + 1
              || (request.resource.data.count == 1
                  && request.resource.data.day > resource.data.day));
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && (ownsCounter()
            || (request.resource.data.keys().hasOnly(['count', 'day'])
                && request.resource.data.count == 1));
      allow update: if signedIn()
        && (nextQueueNumber()
            || (ownsCounter()
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['active', 'activeAt'])));
    }
  }
}
